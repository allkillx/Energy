# Copy to .env (git-ignored) and fill in. Never commit .env.
# The API key is only read by the Python backend; it is never sent to the browser or written to logs.
NEOPOINT_API_KEY=

# NEOpoint report links (CSV). Paste each link and replace the key value in it with {key}.
# Optional placeholders: {from} {to} -> NEM-time dates at fetch time; {instances} -> each value of NEOPOINT_INSTANCES_<FEED>.
# NOS link structure taken from the user-supplied link (only key/from/instances turned into placeholders):
NEOPOINT_URL_NOS_OUTAGES=https://neopoint.com.au/Service/Csv?f=106%20Flows%20and%20Constraints%5CNOS%20Planned%20Outages%20by%20Region&from={from}%2000%3A00&period=Daily&instances={instances}&section=-1&key={key}
NEOPOINT_INSTANCES_NOS_OUTAGES=NSW1,QLD1,VIC1,SA1,TAS1

# Not yet provided: paste the real links for these reports.
NEOPOINT_URL_CONSTRAINTS=
NEOPOINT_URL_INTERCONNECTORS=
NEOPOINT_URL_PRICE_DUID=
NEOPOINT_URL_PRICE_REGION=
